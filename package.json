{
	"name": "n8n-nodes-subtraq",
	"version": "0.1.0",
	"description": "n8n nodes for Subtraq: create short links and placements, read clicks, leads, sales and attributed revenue, record sales, and start workflows on new leads and sales.",
	"license": "MIT",
	"homepage": "https://subtraq.co",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"subtraq",
		"short-links",
		"link-tracking",
		"attribution",
		"utm",
		"webhook"
	],
	"author": {
		"name": "Subtraq",
		"email": "contact@subtraq.co",
		"url": "https://subtraq.co"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/subtraq/n8n-nodes-subtraq.git"
	},
	"bugs": {
		"url": "https://github.com/subtraq/n8n-nodes-subtraq/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test \"test/*.test.mjs\"",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SubtraqApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Subtraq/Subtraq.node.js",
			"dist/nodes/SubtraqTrigger/SubtraqTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.50.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
